{"step_index":372,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T08:14:06Z","content":"Created At: 2026-11-15T13:44:06+05:30\nCompleted At: 2026-11-15T13:44:07+05:30\nCommand exited with code 0.\n\nCommand output:\n3561:function get_windows() {\r\n3562-    if [ \"${OS}\" == \"windows-server\" ]; then\r\n3563-        download_windows_server \"windows-server-${RELEASE}\"\r\n3564-    else\r\n3565-        download_windows_workstation \"${RELEASE}\"\r\n3566-    fi\r\n3567-\r\n3568-    if [ \"${OPERATION}\" == \"download\" ]; then\r\n3569-        exit 0\r\n3570-    fi\r\n3571-\r\n3572-    echo \"Downloading VirtIO drivers...\"\r\n3573-    web_get \"https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso\" \"${VM_PATH}\"\r\n3574-\r\n3575-    rm -f \"${VM_PATH}/unattended.iso\"\r\n3576-    case ${RELEASE} in\r\n3577-        10|11)\r\n3578-            unattended_windows \"${VM_PATH}\"\r\n3579-            ;;\r\n3580-    esac\r\n3581-\r\n3582-    if [ -n \"${FILE_NAME}\" ]; then\r\n3583-        make_vm_config \"${FILE_NAME}\" \"virtio-win.iso\"\r\n3584-    else\r\n3585-        make_vm_config \"windows-${RELEASE}.iso\" \"virtio-win.iso\"\r\n3586-    fi\r\n--\r\n4050:        get_windows\r\n4051-    else\r\n4052-        validate_release \"releases_${OS}\"\r\n4053-        create_vm \"$(\"get_${OS}\")\"\r\n4054-    fi\r\n4055-else\r\n4056-    error_specify_release\r\n4057-fi\r\n4058-\r\n4059-# vim:tabstop=4:shiftwidth=4:expandtab\r\n"}
