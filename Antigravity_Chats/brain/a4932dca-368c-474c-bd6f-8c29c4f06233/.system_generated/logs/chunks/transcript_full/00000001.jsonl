E:\n                shutil.copy2(fp, os.path.join(target, f))\n    print(\"STM32CubeIDE copied.\")\n\n# 3. Arduino\nard_src = os.path.join(home, 'Arduino')\nard_dst = os.path.join(backup_root, 'Arduino')\nif os.path.exists(ard_src):\n    shutil.copytree(ard_src, ard_dst, dirs_exist_ok=True)\n    print(\"Arduino copied.\")\n\n# 4. drawing.svg\nsvg_src = os.path.join(home, 'drawing.svg')\nif os.path.exists(svg_src):\n    shutil.copy2(svg_src, os.path.join(backup_root, 'drawing.svg'))\n    print(\"drawing.svg copied.\")\n\n# 5. Configs\ncfg_dst = os.path.join(backup_root, 'configs')\nos.makedirs(cfg_dst, exist_ok=True)\nfor cfg in ['.bashrc', '.gitconfig', '.profile']:\n    cp = os.path.join(home, cfg)\n    if os.path.exists(cp):\n        shutil.copy2(cp, os.path.join(cfg_dst, cfg))\nprint(\"configs copied.\")\nEOF\n","WaitMsBeforeAsync":10000,"toolSummary":"Copy remaining home project folders"}}]}
