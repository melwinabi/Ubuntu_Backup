me, 'Documents')\ndoc_backup = os.path.join(backup, 'Documents')\nfor item in sorted(os.listdir(doc_home)):\n    hp = os.path.join(doc_home, item)\n    bp = os.path.join(doc_backup, item)\n    if not os.path.exists(bp):\n        sz = get_tree_size(hp)\n        print(f\"  - Documents/{item}: {sz / (1024*1024):.1f} MB\")\n\nprint(\"\\n=== 3. Missing Large Files inside tracked Documents (> 50MB) ===\")\nfor r, d, fs in os.walk(doc_home):\n    if any(x in r for x in ['node_modules', '.next', 'venv', 'OneDrive', 'SOFTWARES']):\n        continue\n    rel = os.path.relpath(r, doc_home)\n    backup_r = os.path.join(doc_backup, rel)\n    for f in fs:\n        hp = os.path.join(r, f)\n        bp = os.path.join(backup_r, f)\n        if not os.path.exists(bp):\n            try:\n                sz = os.path.getsize(hp)\n                if sz > 50 * 1024 * 1024:\n                    print(f\"  - Documents/{os.path.join(rel, f)}: {sz / (1024*1024):.1f} MB\")\n            except:\n                pass\n\nprint(\"\\n=== 4. Missing Items in Downloads ===\")\ndl_home = os.path.join(home, 'Downloads')\ndl_backup = os.path.join(backup, 'Downloads')\nfor item in sorted(os.listdir(dl_home)):\n    if item == 'srm':\n        continue\n    hp = os.path.join(dl_home, item)\n    bp = os.path.join(dl_backup, item)\n    if not os.path.exists(bp):\n        sz = get_tree_size(hp)\n        print(f\"  - Downloads/{item}: {sz / (1024*1024):.1f} MB\")\nEOF\n","WaitMsBeforeAsync":5000,"toolSummary":"Accurate scan of all missing items"}}]}
