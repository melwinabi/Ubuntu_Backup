ass\n    elif item in ['configs']:\n        pass\n    else:\n        # Check what this unmapped item is\n        sz = 0\n        if os.path.isfile(hp):\n            sz = os.path.getsize(hp)\n        else:\n            for r, d, fs in os.walk(hp):\n                for f in fs:\n                    sz += os.path.getsize(os.path.join(r, f))\n        missing_dirs.append((item, sz))\n\nprint(\"=== Unbacked up Top-Level Items ===\")\nfor name, sz in missing_dirs:\n    print(f\"{sz / (1024*1024):.2f} MB : {name}\")\n\n# 2. Check missing files in Documents\nprint(\"\\n=== Missing items in Documents ===\")\ndoc_home = os.path.join(home, 'Documents')\ndoc_backup = os.path.join(backup, 'Documents')\nmissing_docs = []\n\nfor item in sorted(os.listdir(doc_home)):\n    hp = os.path.join(doc_home, item)\n    bp = os.path.join(doc_backup, item)\n    if not os.path.exists(bp):\n        sz = 0\n        if os.path.isfile(hp):\n            sz = os.path.getsize(hp)\n        else:\n            for r, d, fs in os.walk(hp):\n                for f in fs:\n                    sz += os.path.getsize(os.path.join(r, f))\n        missing_docs.append((item, sz))\n\nfor name, sz in missing_docs:\n    print(f\"{sz / (1024*1024):.2f} MB : Documents/{name}\")\n\n# 3. Check individual files missing inside existing Documents subfolders (> 10MB)\nmissing_large_doc_files = []\nfor r, d, fs in os.walk(doc_home):\n    if any(x in r for x in ['node_modules', '.next', 'venv', 'OneDrive', 'SOFTWARES']):\n        continue\n    rel = os.path.relpath(r, doc_home)\n    backup_r = os.path.join(doc_backup, rel)\n    for f in fs:\n        hp = os.path.join(r, f)\n        bp = os.path.join(backup_r, f)\n        if not os.path.exists(bp):\n            sz = os.path.getsize(hp)\n            if sz > 5 * 1024 * 1024: # > 5MB\n                missing_large_doc_files.append((os.path.join(rel, f), sz))\n\nprint(\"\\n=== Large files missing inside tracked Documents (> 10MB) ===\")\nfor name, sz in missing_large_doc_files:\n    print(f\"{sz / (1024*1024):.2f} MB : Documents/{name}\")\n\n# 4. Check missing items in Downloads\nprint(\"\\n=== Missing items in Downloads ===\")\ndl_home = os.path.join(home, 'Downloads')\ndl_backup = os.path.join(backup, 'Downloads')\nmissing_dls = []\nfor item in sorted(os.listdir(dl_home)):\n    if item == 'srm': # srm is at root of backup\n        continue\n    hp = os.path.join(dl_home, item)\n    bp = os.path.join(dl_backup, item)\n    if not os.path.exists(bp):\n        sz = 0\n        if os.path.isfile(hp):\n            sz = os.path.getsize(hp)\n        else:\n            for r, d, fs in os.walk(hp):\n                for f in fs:\n                    sz += os.path.getsize(os.path.join(r, f))\n        missing_dls.append((item, sz))\n\nfor name, sz in missing_dls:\n    print(f\"{sz / (1024*1024):.2f} MB : Downloads/{name}\")\nEOF\n","WaitMsBeforeAsync":5000,"toolSummary":"Find all missing files and folders"}}]}
