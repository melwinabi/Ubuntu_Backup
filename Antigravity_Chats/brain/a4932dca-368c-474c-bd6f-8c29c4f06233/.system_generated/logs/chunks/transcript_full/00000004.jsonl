{"step_index":370,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T08:14:01Z","content":"Created At: 2026-11-15T13:44:01+05:30\nCompleted At: 2026-11-15T13:44:02+05:30\nCommand exited with code 0.\n\nCommand output:\n            GUEST=\"solaris\"\r\n            IMAGE_TYPE=\"iso\";;\r\n        reactos)\r\n            GUEST=\"reactos\"\r\n            IMAGE_TYPE=\"iso\";;\r\n        ubuntu*)\r\n            GUEST=\"linux\"\r\n            IMAGE_TYPE=\"iso\"\r\n            # If there is a point in the release, check if it is less than 16.04\r\n            if [[ \"${RELEASE}\" != *\"daily\"* ]]; then\r\n                if [ \"${RELEASE//./}\" -lt 1604 ]; then\r\n                    GUEST=\"linux_old\"\r\n                fi\r\n            fi\r\n            ;;\r\n        windows)\r\n            GUEST=\"windows\"\r\n            IMAGE_TYPE=\"iso\";;\r\n        windows-server)\r\n            GUEST=\"windows-server\"\r\n            IMAGE_TYPE=\"iso\";;\r\n        *)\r\n            GUEST=\"linux\"\r\n            IMAGE_TYPE=\"iso\";;\r\n    esac\r\n\r\n    CONF_FILE=\"${VM_PATH}.conf\"\r\n\r\n    if [ ! -e \"${CONF_FILE}\" ]; then\r\n        echo \"Making ${CONF_FILE}\"\r\n        local ARCH_LINE=\"\"\r\n        if [ \"${ARCH}\" != \"${NORMALISED_HOST_ARCH}\" ]; then\r\n            if [ \"${ARCH}\" == \"arm64\" ]; then\r\n                ARCH_LINE=\"arch=\\\"aarch64\\\"\"\r\n            else\r\n                ARCH_LINE=\"arch=\\\"x86_64\\\"\"\r\n            fi\r\n        fi\r\n        cat << EOF > \"${CONF_FILE}\"\r\n#!${QUICKEMU} --vm\r\nguest_os=\"${GUEST}\"\r\n${ARCH_LINE:+${ARCH_LINE}\r\n}disk_img=\"${VM_PATH}/disk.qcow2\"\r\n${IMAGE_TYPE}=\"${VM_PATH}/${IMAGE_FILE}\"\r\nEOF\r\n        echo \" - Setting ${CONF_FILE} executable\"\r\n        chmod u+x \"${CONF_FILE}\"\r\n        if [ -n \"${ISO_FILE}\" ]; then\r\n            echo \"fixed_iso=\\\"${VM_PATH}/${ISO_FILE}\\\"\" >> \"${CONF_FILE}\"\r\n        fi\r\n\r\n"}
