// Map ASCII character to font index
int getFontIndex(char c) {
  if (c == ' ') return 0;
  if (c >= 'A' && c <= 'Z') return c - 'A' + 1;
  if (c >= '0' && c <= '9') return c - '0' + 27;
  return 0; // fallback
}

void setup() {
  Serial.begin(115200);

  // E-Paper pins
  pinMode(34, INPUT);   // BUSY
  pinMode(16, OUTPUT);  // RES
  pinMode(17, OUTPUT);  // DC
  pinMode(5, OUTPUT);   // CS

  SPI.begin(18, -1, 23, -1); // HSPI
  SPI.beginTransaction(SPISettings(10000000, MSBFIRST, SPI_MODE0));

  EPD_HW_Init();
  EPD_W21_WriteCMD(0x11); // data entry mode
  EPD_W21_WriteDATA(0x01);
  EPD_WhiteScreen_White();
  delay(500);
  EPD_HW_Init(); //Full screen refresh initialization.
  EPD_WhiteScreen_ALL(valve_image_close); //To Display one image using full screen refresh.
  EPD_DeepSleep(); //Enter the sleep mode and please do not delete it, otherwise it will reduce the lifespan of the screen.
  delay(2000); //Delay for 2s. 
}

void loop() {
  if (Serial.available()) {
    String text = Serial.readStringUntil('\n');
    text.toUpperCase();
   // text = reverseString(text); // reverse to fix mirror issue
    displayTextVertical(text);
    Serial.println("Printed: " + text);
  }
  delay(100);
}

// Reverse string
String reverseString(String s) {
  String r = "";
  for (int i = s.length() - 1; i >= 0; i--) r += s[i];
  return r;
}

// Display vertical text
void displayTextVertical(String text) {
  unsigned char buffer[EPD_ARRAY];
  for (int i = 0; i < EPD_ARRAY; i++) buffer[i] = 0xFF;

  int x = 0;
  int y = 0;
  for (int i = 0; i < text.length() && i < TEXT_MAX_LEN; i++) {
    char c = text[i];
    drawCharToBufferVertical(buffer, x, y, c);
    y += 8;
    if (y + 8 > EPD_HEIGHT) {
      y = 0;
      x += 16;
      if (x + 16 > EPD_WIDTH) break;
    }
  }

  EPD_WhiteScreen_ALL(buffer);
  delay(2000);
}

// Draw character vertically
void drawCharToBufferVertical(unsigned char *buffer, int x, int y, char c) {
  int fontIndex = getFontIndex(c);
  const unsigned char *charData = Font8x16[fontIndex];

  for (int row = 0; row < 16; row++) {
    unsigned char line = charData[row];
    for (int col = 0; col < 8; col++) {
      int pixel = (line >> (7 - col)) & 0x01;
      int px = x + row;  // horizontal moves with row
      int py = y + col;  // vertical moves with col
      if (px >= EPD_WIDTH || py >= EPD_HEIGHT) continue;
      int index = px / 8 + py * (EPD_WIDTH / 8);
      if (pixel)
        buffer[index] &= ~(0x80 >> (px % 8));
      else
        buffer[index] |= (0x80 >> (px % 8));
    }
  }
}
